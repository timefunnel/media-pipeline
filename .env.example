# Copy this file to .env and replace every REPLACE_WITH_* value before starting.
# Do not commit .env. It contains real tokens and passwords.

MEDIA_PIPELINE_VERSION=0.1.0
MEDIA_PIPELINE_REVISION=unknown

# Optional JSON override. Leave empty for ordinary per-category env variables.
MEDIA_PIPELINE_LIBRARY_CONFIG=
MEDIA_PIPELINE_LIBRARY_CONFIG_JSON=

# 115 target folder ids. Create these folders in 115/OpenList first and copy
# each cid from the 115 web URL.
MEDIA_PIPELINE_MOVIE_FOLDER_ID=REPLACE_WITH_115_MOVIE_CID
MEDIA_PIPELINE_MOVIE_OPENLIST_PATH=/115/电影
MEDIA_PIPELINE_TV_FOLDER_ID=REPLACE_WITH_115_TV_CID
MEDIA_PIPELINE_TV_OPENLIST_PATH=/115/剧集
MEDIA_PIPELINE_ANIME_FOLDER_ID=REPLACE_WITH_115_ANIME_CID
MEDIA_PIPELINE_ANIME_OPENLIST_PATH=/115/动漫
MEDIA_PIPELINE_ADULT_FOLDER_ID=REPLACE_WITH_115_ADULT_CID
MEDIA_PIPELINE_ADULT_OPENLIST_PATH=/115/成人
MEDIA_PIPELINE_OTHER_FOLDER_ID=REPLACE_WITH_115_OTHER_CID
MEDIA_PIPELINE_OTHER_OPENLIST_PATH=/115/其他

# MediaStationGo library/root ids are normally auto-discovered from
# MSG_DATABASE_DSN by media_type + OpenList root path. Leave these empty unless
# you need to override ambiguous MSG roots manually.
MEDIA_PIPELINE_MOVIE_MSG_LIBRARY_ID=
MEDIA_PIPELINE_MOVIE_MSG_ROOT_ID=
MEDIA_PIPELINE_MOVIE_MSG_PROVIDER=tmdb
MEDIA_PIPELINE_MOVIE_MSG_MEDIA_TYPE=movie
MEDIA_PIPELINE_TV_MSG_LIBRARY_ID=
MEDIA_PIPELINE_TV_MSG_ROOT_ID=
MEDIA_PIPELINE_TV_MSG_PROVIDER=tmdb
MEDIA_PIPELINE_TV_MSG_MEDIA_TYPE=tv
MEDIA_PIPELINE_ANIME_MSG_LIBRARY_ID=
MEDIA_PIPELINE_ANIME_MSG_ROOT_ID=
MEDIA_PIPELINE_ANIME_MSG_PROVIDER=tmdb
MEDIA_PIPELINE_ANIME_MSG_MEDIA_TYPE=anime
MEDIA_PIPELINE_ADULT_MSG_LIBRARY_ID=
MEDIA_PIPELINE_ADULT_MSG_ROOT_ID=
MEDIA_PIPELINE_ADULT_MSG_PROVIDER=adult
MEDIA_PIPELINE_ADULT_MSG_MEDIA_TYPE=adult
MEDIA_PIPELINE_OTHER_MSG_LIBRARY_ID=
MEDIA_PIPELINE_OTHER_MSG_ROOT_ID=
MEDIA_PIPELINE_OTHER_MSG_PROVIDER=tmdb
MEDIA_PIPELINE_OTHER_MSG_MEDIA_TYPE=movie

# OpenList. OPENLIST_TOKEN should be an admin token because the pipeline writes
# Meta Hide rules. OPENLIST_MEDIA_SCAN_* may be a dedicated OpenList user.
OPENLIST_TOKEN=REPLACE_WITH_OPENLIST_ADMIN_TOKEN
OPENLIST_MEDIA_SCAN_USERNAME=media_scan
OPENLIST_MEDIA_SCAN_PASSWORD=REPLACE_WITH_OPENLIST_MEDIA_SCAN_PASSWORD
OPENLIST_DB=/openlist-data/data.db
OPENLIST_URL=http://127.0.0.1:5244

# Telegram bot.
TG_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TG_ALLOWED_USER_IDS=REPLACE_WITH_TELEGRAM_USER_ID

# Bot state and task behavior.
BOT_STATE_DB=/bot-data/state.db
BOT_SEARCH_LIMIT=100
BOT_SEARCH_PAGE_SIZE=5
BOT_TASK_LIST_PAGE_SIZE=5
BOT_TASK_LIST_FETCH_LIMIT=100
TG_API_TIMEOUT=90
BOT_SYNC_RECOVERY_INTERVAL_SECONDS=60
BOT_TASK_WORKERS=2
BOT_TASK_MESSAGE_EDIT_MIN_INTERVAL_SECONDS=2

# MediaStationGo API and database.
MSG_BASE_URL=http://127.0.0.1:18080/api
MSG_DATABASE_DSN=postgresql://mediastation:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:15432/mediastation
MSG_ADMIN_USER=admin
MSG_ADMIN_PASSWORD=REPLACE_WITH_MSG_ADMIN_PASSWORD
MSG_ENABLED=1
MSG_SYNC_POLL_SECONDS=60
MSG_SYNC_POLL_INTERVAL_SECONDS=5
MSG_TRASH_HIDE_SYNC_ENABLED=1
MSG_TRASH_HIDE_SYNC_LIMIT=100

# Subtitle matching.
SUBTITLE_AUTO_MATCH_ENABLED=1
SUBTITLE_AUTO_MATCH_ADULT_ONLY=1
SUBTITLE_CACHE_DIR=/subtitle-cache
SUBTITLE_PROVIDERS=subtitlecat,assrt,opensubtitles
SUBTITLE_SEARCH_TIMEOUT_SECONDS=12
SUBTITLE_DOWNLOAD_MAX_BYTES=2097152
SUBTITLE_BACKFILL_DEFAULT_LIMIT=20
ASSRT_API_TOKEN=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# OpenList cleanup before MSG scan.
OPENLIST_PRE_SCAN_CLEAN_ENABLED=1
OPENLIST_PRE_SCAN_CLEAN_MAX_BYTES=20971520
OPENLIST_ADULT_CODE_FORMAT_ENABLED=1

# Prowlarr.
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_CONFIG=/prowlarr-config/config.xml
PROWLARR_SEARCH_TIMEOUT_SECONDS=4
PROWLARR_UPSTREAM_SEARCH_LIMIT=100
PROWLARR_REQUIRED_INDEXER_SEARCH_LIMIT=1000
PROWLARR_ANIME_INDEXER_SEARCH_LIMIT=100
PROWLARR_PRIMARY_INDEXER_TIMEOUT_SECONDS=12
PROWLARR_OPTIONAL_INDEXER_TIMEOUT_SECONDS=12
PROWLARR_MAX_WORKERS=8
PROWLARR_EARLY_RETURN_AFTER_SECONDS=2
PROWLARR_EARLY_RETURN_MIN_RESULTS=8
PROWLARR_EARLY_RETURN_REQUIRED_PRIORITY=10
PROWLARR_PROFILE_GENERAL_UPSTREAM_LIMIT=100
PROWLARR_PROFILE_ADULT_UPSTREAM_LIMIT=100
PROWLARR_PROFILE_ANIME_UPSTREAM_LIMIT=100
PROWLARR_PROFILE_GENERAL_TIMEOUT_SECONDS=4
PROWLARR_PROFILE_ADULT_TIMEOUT_SECONDS=4
PROWLARR_PROFILE_ANIME_TIMEOUT_SECONDS=4
PROWLARR_PROFILE_GENERAL_MAX_WORKERS=8
PROWLARR_PROFILE_ADULT_MAX_WORKERS=8
PROWLARR_PROFILE_ANIME_MAX_WORKERS=8
PROWLARR_PROFILE_GENERAL_CATEGORIES=2000,5000
PROWLARR_PROFILE_ADULT_CATEGORIES=6000,2000,5000
PROWLARR_PROFILE_ANIME_CATEGORIES=2000,5000
PROWLARR_PROFILE_GENERAL_TAG_LABELS=media-general,general
PROWLARR_PROFILE_ADULT_TAG_LABELS=media-adult,adult
PROWLARR_PROFILE_ANIME_TAG_LABELS=media-anime,anime

# PanSou netdisk search. The compose file can run the local PanSou API service on 127.0.0.1:8888.
PANSOU_ENABLED=0
PANSOU_URL=http://127.0.0.1:8888
PANSOU_TOKEN=
PANSOU_TIMEOUT_SECONDS=5
PANSOU_CLOUD_TYPES=115
PANSOU_SOURCE_TYPE=all
PANSOU_PLUGINS=
PANSOU_IMAGE=ghcr.io/fish2018/pansou:latest
PANSOU_PORT=8888
PANSOU_CACHE_DIR=/data/pansou/cache
PANSOU_MEM_LIMIT=512m
PANSOU_CPUS=1.0
PANSOU_SERVER_CHANNELS=tgsearchers6,yunpanx,yp123pan,wp123zy,Lsp115,oneonefivewpfx,Channel_Shares_115,vip115hot,gimy115,gimy115iso,gokuapan,Q_dongman,Netdisk_Movies
PANSOU_SERVER_ENABLED_PLUGINS=hunhepan,jikepan,panwiki,pansearch,panta,qupansou,hdr4k,pan666,susu,qupanshe,xdpan,qqpd,gying,ash
PANSOU_CACHE_ENABLED=true
PANSOU_CACHE_MAX_SIZE=100
PANSOU_CACHE_TTL=60
PANSOU_ASYNC_PLUGIN_ENABLED=true
PANSOU_ASYNC_RESPONSE_TIMEOUT=4
PANSOU_ASYNC_MAX_BACKGROUND_WORKERS=8
PANSOU_ASYNC_MAX_BACKGROUND_TASKS=40
PANSOU_ASYNC_CACHE_TTL_HOURS=1
PANSOU_AUTH_ENABLED=false
PANSOU_AUTH_USERS=
PANSOU_AUTH_TOKEN_EXPIRY=24
PANSOU_AUTH_JWT_SECRET=

# Optional LLM rerank. Leave disabled unless the key and timeout are acceptable.
LLM_SEARCH_RERANK_ENABLED=0
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=4
LLM_SEARCH_RERANK_LIMIT=40
LLM_THINKING_DISABLED=1
