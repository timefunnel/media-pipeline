DANMAKU_SERVER_TOKEN=replace-with-a-random-token-at-least-16-characters
# 按从高到低排序；高优先级唯一命中后不再查询后续源。
DANMAKU_PROVIDERS=tencent,iqiyi,dandanplay
DANMAKU_CACHE_DIR=/danmaku-cache
DANMAKU_CACHE_TTL_SECONDS=604800
DANMAKU_SEARCH_CACHE_TTL_SECONDS=86400
DANMAKU_NEGATIVE_CACHE_TTL_SECONDS=3600
DANMAKU_SEARCH_TIMEOUT_SECONDS=30
DANMAKU_COMMENT_TIMEOUT_SECONDS=90
DANMAKU_MAX_COMMENTS=6000
# 弹弹play 优先级最低，必须提供凭据；前两源命中后不调用它。
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=
# 可加入 aggregator；需兼容弹弹play search/episodes 和 comment 协议。
DANMAKU_AGGREGATOR_URL=
# 仅用于 dandanplay / aggregator 的 HTTP 传输。
DANMAKU_PROXY_URL=
